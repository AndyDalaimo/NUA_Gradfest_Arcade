script = ExtResource("2_bm3dg")
app_path = "HSWP_Wx64/Windows/HOTSWAP/Binaries/Win64/HOTSWAP-Win64-Shipping.exe"
app_title = "HOTSWAP - City Demo
[font_size=32]Developed by: Charlie Hannan[/font_size]"
app_texture = ExtResource("1_hurah")
app_description = "Punch, slide and shoot your way through enemies in the City Demo, a proof of concept build of HOTSWAP.

Set in the near future, explore and fight your way through a dystopian, authoritarian UK controlled by the AI system POLaRIS and its robot police officers. Play as a reprogrammed police unit given sentience: swap out weapons mid-combat by physically attaching them to your arms, rise up and take the system down from within - you are the poison that will set the people free.

This demo focuses on a single level set in a city setting midway through the game's story, featuring a tutorial and a short shootout with enemies. As this is a demo, content is very much subject to change and doesn't reflect the final state of the game. Many features are still work in progress (namely the placeholder enemies and level textures) and there are several bugs, though none are game-breaking.

If you would like to leave feedback after playing please scan the QR code and fill out the google form. Please don't mention any issues that are outlined on the form's description, as I'm already aware of these and am actively working on changing!
"
sc_1 = ExtResource("2_i2esf")
app_tag = "GradFest 2026"
metadata/_custom_type_script = "uid://naagfv3mx6to"
