app_texture = ExtResource("1_ubix2")
app_description = "Tower of Trials is a Mystery-Dungeon inspired game where the player battles through randomly-generated dungeons to gain loot and power. The twist, however, is that the player can actively affect how the dungeon spawns and what spawns in it every run, by using a crafting grid that increased in size and complexity as the game progresses."
