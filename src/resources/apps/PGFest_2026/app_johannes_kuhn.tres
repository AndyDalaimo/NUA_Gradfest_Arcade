[resource]
script = ExtResource("1_wnl4k")
app_path = "Johannes_Kuhn_Game/TowerOfTrials_prototype1_5_2.exe"
app_title = "Tower of Trials
[font_size=32]Developed by: Jan Kuhn[/font_size]
[font_size=20]Genre: Turn-based hack and slash[/font_size]"
app_texture = ExtResource("2_ubix2")
app_description = "This project’s main inspirations were the endless hours I sank into the Pokemon Mystery Dungeon games as a child, and the endgame map-crafting systems of Path of Exile. I wanted to design a game where the main mechanic was the player being able to affect random generation in specific, less gambling-adjacent ways, which dovetailed nicely into the Mystery Dungeon genre.

In this demo players can choose a class, construct a unique dungeon by dragging terrain and feature tiles into a template and then delve into the dungeon as a turn-based hack and slash. Running the dungeon rewards players with more tiles to build increasingly sophisticated or specialised dungeons that suit their play style. "
sc_1 = ExtResource("1_omttn")
sc_2 = ExtResource("3_7rqef")
app_tag = "PG Fest 2026"
metadata/_custom_type_script = "uid://naagfv3mx6to"
